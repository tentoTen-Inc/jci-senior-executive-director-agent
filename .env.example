# =============================================================
# JCI 専務理事AIエージェント 環境変数テンプレート
# 実値は .env に記載する（.env はコミットしないこと）
# =============================================================

# --- LINE Messaging API ---
LINE_BASIC_ID=@xxxxxxxx
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- GCP / Vertex AI (Gemini) ---
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
VERTEX_AI_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firestore ---
FIRESTORE_DATABASE=(default)

# --- 対外連絡のGmail取込（F5-1）---
# 専用Gmail(inawashiro.jc@gmail.com)は個人アカウントのため OAuth refresh token 方式。
# 取得は scripts/gmail_oauth_setup.py、本番は Secret Manager
# (gmail-oauth-client-id / -client-secret / -refresh-token) を参照する。
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# 取込対象ラベル（未指定は「対外連絡」）
GMAIL_LABEL=

# --- コスト概算（KPIの「当月コスト」用・任意）---
# 未指定ならモデル別の既定単価（app/inference.py の MODEL_PRICES）を使用。
# 単価改定時は両方セットして上書きする（USD / 100万トークン）。
LLM_PRICE_INPUT_USD_PER_1M=
LLM_PRICE_OUTPUT_USD_PER_1M=
# Cloud Run 等の固定インフラ費の月額概算（USD）。未指定は0。
INFRA_MONTHLY_USD=

# --- アプリ設定 ---
TZ=Asia/Tokyo
LOM_ID=
